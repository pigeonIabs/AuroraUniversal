{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.1",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "background": {
    "scripts": [
      "modules/aurora/sites.js",
      "modules/aurora/preferences.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://opal.google.com/_gemini*",
    "https://opal.google/_app/*",
    "https://grok.com/*",
    "https://chat.qwen.ai/*",
    "https://aistudio.google.com/*",
    "https://chat.deepseek.com/*",
    "https://huggingface.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aurora-universal@pigeonlabs",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "commands": {
    "toggle-visibility": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle Focus Mode (Visibility)"
    },
    "toggle-blur": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Toggle Blur (Streamer Mode)"
    }
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://huggingface.co/*"
      ],
      "js": [
        "modules/aurora/sites.js"
      ],
      "css": [
        "shared.css",
        "glass-control.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "modules/aurora/adapters/chatgpt.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "modules/aurora/adapters/claude.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "modules/aurora/adapters/gemini.js",
        "modules/aurora/gemini-gems.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "modules/aurora/adapters/grok.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "modules/aurora/adapters/qwen.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "modules/aurora/adapters/aistudio.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "modules/aurora/adapters/deepseek.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://huggingface.co/*"
      ],
      "js": [
        "modules/aurora/adapters/huggingface.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "styles.css",
        "new-features.css",
        "app-skin.css",
        "features.css",
        "chatgpt-ads.css",
        "fonts.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://huggingface.co/*"
      ],
      "css": [
        "universal.css",
        "features.css",
        "fonts.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://huggingface.co/*"
      ],
      "js": [
        "modules/aurora/namespace.js",
        "modules/aurora/preferences.js",
        "modules/aurora/config.js",
        "modules/aurora/utils.js",
        "modules/aurora/root-flags.js",
        "modules/aurora/background.js",
        "modules/aurora/startup.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://huggingface.co/*"
      ],
      "js": [
        "modules/aurora/dom.js",
        "modules/aurora/central-observer.js",
        "modules/aurora/material.js",
        "modules/aurora/text-frost.js",
        "modules/aurora/i18n.js",
        "modules/aurora/fonts.js",
        "modules/aurora/contrast.js",
        "modules/aurora/upgrade.js",
        "modules/aurora/interface.js",
        "modules/aurora/ai-warnings.js",
        "modules/aurora/glass-control.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "modules/aurora/chatgpt-ads.js",
        "modules/aurora/glass.js",
        "modules/aurora/default-model.js",
        "modules/aurora/quick-settings.js",
        "modules/aurora/audio.js",
        "modules/aurora/masking.js",
        "modules/aurora/welcome.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://aistudio.google.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "modules/aurora/surfaces.js",
        "modules/aurora/quick-settings.js",
        "modules/aurora/audio.js",
        "modules/aurora/masking.js",
        "modules/aurora/model-preferences.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://huggingface.co/*"
      ],
      "js": [
        "modules/aurora/surfaces.js",
        "modules/aurora/quick-settings.js",
        "modules/aurora/audio.js",
        "modules/aurora/masking.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://huggingface.co/*"
      ],
      "js": [
        "modules/aurora/queue.js",
        "modules/aurora/disable.js",
        "modules/aurora/orchestrator.js",
        "modules/aurora/init.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://opal.google.com/_gemini*",
        "https://opal.google/_app/*"
      ],
      "js": [
        "modules/aurora/gemini-gems.js"
      ],
      "css": [
        "gemini-gems.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/grok-4.webp",
        "assets/space-stars.svg",
        "assets/themes/*",
        "assets/health-zero-state-records-*.svg",
        "_locales/*/messages.json",
        "assets/fonts/*",
        "modules/message-queue.js",
        "data-masking.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://huggingface.co/*"
      ]
    }
  ],
  "homepage_url": "https://github.com/pigeonIabs/AuroraUniversal"
}
